<main class="container narrow">
  <% if notice.present? %>
    <p class="notice"><%= notice %></p>
  <% end %>

  <article class="card">
    <header class="movie-heading">
      <h1><%= @movie.title %></h1>
      <span class="rating"><%= @movie.rating %></span>
    </header>

    <h2>Description</h2>
    <p><%= @movie.description.presence || "No description available." %></p>

    <h2>Release Date</h2>
    <p><%= @movie.release_date&.strftime("%B %d, %Y") || "Unknown" %></p>
  </article>

  <div class="button-row">
    <%= link_to "Edit", edit_movie_path(@movie), class: "button" %>
    <%= link_to "Back to Movies", movies_path, class: "button secondary" %>

    <%= button_to "Delete",
                  @movie,
                  method: :delete,
                  class: "button danger" %>
  </div>
</main>