<%= form_with(model: movie, class: "movie-form") do |form| %>
  <% if movie.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(movie.errors.count, "error") %> prevented saving:</h2>

      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :rating %>
    <%= form.select :rating, ["G", "PG", "PG-13", "R", "NC-17"], prompt: "Select a rating" %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <div class="field">
    <%= form.label :release_date %>
    <%= form.date_field :release_date %>
  </div>

  <div class="button-row">
    <%= form.submit class: "button" %>
    <%= link_to "Cancel", movies_path, class: "button secondary" %>
  </div>
<% end %>